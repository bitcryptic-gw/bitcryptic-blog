---
export const prerender = false;
import { marked } from 'marked';
import SitePost from '../../site/Post.astro';
import { getSite } from '../../lib/site.mjs';

const { slug } = Astro.params;
const site = getSite();

const post = site.posts.find(p => p.slug === slug);

// A post that fails validation is skipped by the loader, not 500'd: the site
// keeps serving everything else, and the sync loop will have refused to publish
// it anyway.
//
// An unknown or draft slug is a real 404 at its own URL: no redirect, which
// crawlers read as a soft 404. The page body is the theme's not-found page, and
// the middleware serves its markdown counterpart when one was negotiated.
if (!post) {
  Astro.response.status = 404;
  return Astro.rewrite('/404');
}

const contentHtml = await marked(post.content);
---

<SitePost post={post} site={site.config}>
  <div set:html={contentHtml} />
</SitePost>
