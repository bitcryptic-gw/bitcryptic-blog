---
export const prerender = false;
/**
 * `/` — the site's home page.
 *
 * A site with a published home page (`pages/index.md`) renders it with the
 * layout its frontmatter names. A site without one is the blog, and renders the
 * post index, exactly as it always has.
 */
import { marked } from 'marked';
import SiteIndex from '../site/Index.astro';
import SitePage from '../site/Page.astro';
import { getSite, homePage } from '../lib/site.mjs';
import { themeInfo } from '../lib/themes.mjs';

const site = getSite();
const home = homePage(site);

if (!home && site.config.theme !== 'blog') {
  // A pages-only site with no home page yet has nothing to serve here.
  Astro.response.status = 404;
  return Astro.rewrite('/404');
}

const contentHtml = home ? await marked(home.content) : '';
const hasPageLayout = themeInfo(site.config.theme).pageLayouts.length > 0;
---

{home && hasPageLayout ? (
  <SitePage page={home} site={site.config}>
    <div set:html={contentHtml} />
  </SitePage>
) : (
  <SiteIndex posts={site.posts} site={site.config} />
)}
